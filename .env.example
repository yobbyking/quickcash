# ===========================================
# QuickCash — Environment Variables
# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables
# ===========================================

# --- Database (REQUIRED) ---
# Neon (recommended): https://neon.tech → New Project → copy connection string
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# --- Firebase Client (REQUIRED — exposed to browser) ---
# Firebase Console → Project Settings → "Your apps" → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abc123"

# --- Firebase Admin (REQUIRED — server-only, secret) ---
# Firebase Console → Project Settings → Service Accounts → "Generate new private key"
# Then copy the project_id, client_email, and private_key values
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- SwiftWallet v3 API (REQUIRED for M-Pesa payments) ---
SWIFTWALLET_API_KEY="sw_588b7ac498489355a76104fd73b8f51cb9fa597916597c12dca88be2"
SWIFTWALLET_API_URL="https://api.swiftwallet.co.ke/v3"
