# ===========================================
# SwiftPay Environment Variables
# Copy this file to `.env` for local dev,
# or set these in Vercel → Project → Settings → Environment Variables
# ===========================================

# --- Database (REQUIRED) ---
# Use any hosted PostgreSQL provider:
#   - Neon (free):         https://neon.tech       -> postgresql://user:pass@host/db?sslmode=require
#   - Supabase (free):     https://supabase.com    -> postgresql://postgres.xxxx:pass@host:5432/postgres
#   - Vercel Postgres:     https://vercel.com/db   -> use the "prisma" connection string
#   - Railway (free):      https://railway.app
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# --- Auth (REQUIRED) ---
# A long random string used to sign JWT session tokens.
# Generate one with: openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string-please-at-least-32-chars-long"

# --- SwiftWallet v3 API (REQUIRED for real payments) ---
# Get your API key from https://swiftwallet.co.ke
# The current demo key below works for STK push + B2C.
SWIFTWALLET_API_KEY="sw_588b7ac498489355a76104fd73b8f51cb9fa597916597c12dca88be2"
SWIFTWALLET_API_URL="https://api.swiftwallet.co.ke/v3"

# --- App config (REQUIRED) ---
NEXT_PUBLIC_APP_NAME="SwiftPay"
NEXT_PUBLIC_BCLB_NUMBER="7YGEB3OD"
NEXT_PUBLIC_ACTIVATION_FEE="150"
