// Prisma schema for the QuickCash-style platform with Firebase auth + tiered activation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  firebaseUid     String   @unique
  email           String   @unique
  username        String   @unique
  phone           String   @unique
  displayName     String?
  photoURL        String?
  passwordHash    String?  // for email/password auth (Firebase also handles this)
  tier            String   @default("silver")  // silver | gold | vip
  isActivated     Boolean  @default(false)
  balance         Float    @default(0)
  totalEarned     Float    @default(0)
  tasksCompleted  Int      @default(0)
  adsWatchedToday Int      @default(0)
  adsWatchedTotal Int      @default(0)
  lastAdDay       String?
  referralCode    String   @unique
  referredById    String?
  referrer        User?    @relation("Referral", fields: [referredById], references: [id])
  referrals       User[]   @relation("Referral")
  isActive        Boolean  @default(true)
  isAdmin         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        Payment[]
  transactions    Transaction[]
  completions     Completion[]
  adWatches       AdWatch[]
}

model Opportunity {
  id              String   @id @default(cuid())
  title           String
  description     String
  type            String   // TASK | SURVEY
  tier            String   // silver | gold | vip
  category        String
  reward          Float
  estimatedMinutes Int
  status          String   @default("active")  // active | inactive
  maxCompletions  Int      @default(0)  // 0 = unlimited
  questions       Question[]
  completions     Completion[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Question {
  id             String   @id @default(cuid())
  opportunityId  String
  questionOrder  Int
  text           String
  answerType     String   // DROPDOWN | MULTIPLE_CHOICE | RATING | YES_NO | TEXT
  options        String   // JSON array of options (or empty for TEXT)
  required       Boolean  @default(true)
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  answers        Answer[]
}

model Completion {
  id             String   @id @default(cuid())
  userId         String
  opportunityId  String
  status         String   @default("pending")  // pending | completed | rejected
  reward         Float    @default(0)
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  answers        Answer[]
}

model Answer {
  id             String   @id @default(cuid())
  completionId   String
  questionId     String
  value          String   // JSON-encoded answer (string for single, array for multi)
  completion     Completion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  type            String   // ACTIVATION | DEPOSIT | WITHDRAWAL
  amount          Float
  phone           String
  status          String   @default("PENDING")  // PENDING | COMPLETED | FAILED | CANCELLED
  tier            String?  // for ACTIVATION payments
  checkoutRequestId String?
  merchantRequestId String?
  mpesaReceipt    String?
  failureReason   String?
  accountReference String?
  description     String?
  webhookReceived Boolean  @default(false)
  webhookPayload  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // TASK_REWARD | AD_REWARD | REFERRAL_BONUS | WITHDRAWAL | DEPOSIT | ACTIVATION
  amount      Float
  direction   String   // CREDIT | DEBIT
  status      String   @default("COMPLETED")
  reference   String   @unique
  description String?
  relatedPaymentId    String?
  relatedCompletionId String?
  relatedAdWatchId    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdWatch {
  id          String   @id @default(cuid())
  userId      String
  adId        String
  adTitle     String
  reward      Float
  durationSec Int
  status      String   @default("COMPLETED")
  watchedAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
